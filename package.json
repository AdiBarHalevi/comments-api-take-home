{
  "name": "comments-api-take-home",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "type": "module",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:prepare && DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--experimental-vm-modules jest --setupFiles=dotenv/config",
    "test:unit": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--experimental-vm-modules jest --setupFiles=dotenv/config --testPathPatterns=test/unit",
    "test:integration": "npm run test:prepare && DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--experimental-vm-modules jest --setupFiles=dotenv/config --testPathPatterns=test/integration --testPathPatterns=test/routes",
    "test:prepare": "docker compose up -d --wait postgres-test redis && DOTENV_CONFIG_PATH=.env.test prisma migrate deploy",
    "start": "npm run build:ts && fastify start -l info -o dist/app.js",
    "build:ts": "npm run db:generate && tsc",
    "watch:ts": "tsc -w",
    "dev": "tsc && npm-run-all --parallel watch:ts dev:start",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P -o dist/app.js",
    "mocks": "docker compose up mock-instagram mock-x",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "bootstrap": "docker compose up -d --wait && prisma generate && prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.2.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-openapi-glue": "^4.11.4",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "fastify-tsconfig": "^3.0.0",
    "jest": "^30.4.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.4.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.68.0"
  }
}
