# Static brand accounts for platform mocks (take-home).
# Production would use OAuth tokens from connected social accounts.

# Instagram
IG_EXTERNAL_ACCOUNT_ID=17841400000000000
IG_USERNAME=brand_account
IG_ACCESS_TOKEN=test-ig-token
IG_API_BASE_URL=http://localhost:3001/v21.0

# X (Twitter)
X_EXTERNAL_ACCOUNT_ID=2244994945
X_USERNAME=brand
X_ACCESS_TOKEN=test-x-token
X_API_BASE_URL=http://localhost:3002

# Redis (BullMQ) — started by npm run bootstrap
REDIS_URL=redis://localhost:6379
