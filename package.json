{
  "name": "comments-api-take-home",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build:ts && tsc -p test/tsconfig.json && c8 node --test -r ts-node/register \"test/**/*.ts\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "npm run db:generate && tsc",
    "watch:ts": "tsc -w",
    "dev": "npm run build:ts && panex -n TypeScript,App,Instagram,X \"npm run watch:ts\" \"npm run dev:start\" \"npm run mock:instagram\" \"npm run mock:x\"",
    "dev:api": "npm run build:ts && panex -n TypeScript,App \"npm run watch:ts\" \"npm run dev:start\"",
    "dev:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "mocks": "panex -n Instagram,X \"npm run mock:instagram\" \"npm run mock:x\"",
    "mock:instagram": "mockoon-cli start --data mocks/mockoon/instagram.json --port 3001",
    "mock:x": "mockoon-cli start --data mocks/mockoon/x.json --port 3002",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "bootstrap": "docker compose up -d --wait",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.0",
    "fastify-plugin": "^5.0.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mockoon/cli": "^9.8.0",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.23.1",
    "c8": "^11.0.0",
    "panex": "^0.9.28",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "fastify-tsconfig": "^3.0.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "ts-node": "^10.4.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.68.0"
  }
}
